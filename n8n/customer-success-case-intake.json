      "webhookId": "c8b49454-d7b2-4d34-be9b-c22170e896c8"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const body = item.json.body ?? {};\n\n  const subject = String(body.subject ?? \"\").trim();\n  const description = String(body.description ?? \"\").trim();\n  const priority = String(body.priority ?? \"Medium\").trim();\n  const origin = String(body.origin ?? \"Web\").trim();\n\n  let error = null;\n\n  if (!subject) {\n    error = \"Subject is required\";\n  } else if (!description) {\n    error = \"Description is required\";\n  } else if (![\"High\", \"Medium\", \"Low\"].includes(priority)) {\n    error = `Invalid priority: ${priority}`;\n  } else if (![\"Web\", \"Phone\", \"Email\"].includes(origin)) {\n    error = `Invalid origin: ${origin}`;\n  }\n\n  if (error) {\n    return {\n      json: {\n        valid: false,\n        error,\n      },\n    };\n  }\n\n  return {\n    json: {\n      valid: true,\n      subject,\n      description,\n      priority,\n      origin,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        160
      ],
      "id": "bb17cf8e-43fa-4370-af76-c85b2c0dae35",
